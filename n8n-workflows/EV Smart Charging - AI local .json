      "parameters": {
        "jsCode": "// Vi hämtar texten från AI-agentens \"output\"\nconst raw = $input.all()[0].json.output;\n\n// Vi letar efter JSON-mönstret { ... }\nconst jsonMatch = raw.match(/\\{.*\\}/s);\n\nif (jsonMatch) {\n  // Om vi hittar det, gör vi om texten till ett objekt\n  return JSON.parse(jsonMatch[0]);\n}\n\n// Om ingen JSON hittas, skicka ett säkert stopp-svar\nreturn { \n  action: \"wait\", \n  recommended_amps: 0, \n  reason: \"Kunde inte hitta JSON i AI-svaret\" \n};"
