      "parameters": {
        "promptType": "define",
        "text": "=Här är aktuell status för mitt hem:\n\nEasee laddbox: {{ $('Get a state').item.json.state }}\nBil batteri (SoC): {{ $('Get a state1').item.json.state }}%\nElpris just nu: {{ $('Get a state2').item.json.state }} kr/kWh\nSolproduktion: {{ $('Get a state3').item.json.state }} W\n\nDagens lägsta elpris: {{ $('Get a state2').item.json.attributes.min }} kr/kWh\nDagens högsta elpris: {{ $('Get a state2').item.json.attributes.max }} kr/kWh\nGenomsnittspris idag: {{ $('Get a state2').item.json.attributes.average }} kr/kWh\n\nBilen har 52 kWh batteri (VW ID).\nSka jag ladda nu eller vänta? Ge ett konkret råd.",
